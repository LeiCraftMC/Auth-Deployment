# LeiCraft_MC theme of the Zitadel login (Deployment/login override, new file).
# Next.js reads this during `next build` and compiles NEXT_PUBLIC_* values into the bundles, so
# changing them needs a rebuild of the image; setting them on the container has no effect.
# Options: apps/login/THEME_CUSTOMIZATION.md and src/lib/theme.ts upstream.

# marker classes for src/styles/_lcmc.scss (src/lib/theme.ts, APPEARANCE_STYLES.lcmc)
NEXT_PUBLIC_THEME_APPEARANCE=lcmc
NEXT_PUBLIC_THEME_ROUNDNESS=mid
NEXT_PUBLIC_THEME_LAYOUT=top-to-bottom
NEXT_PUBLIC_THEME_SPACING=regular
